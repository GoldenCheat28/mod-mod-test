; Engine configuration file.
; Godot 4.7, физика Jolt.

config_version=5

[application]

config/name="Ragdoll Shooter Test"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameInput="*res://autoload/game_input.gd"
Sfx="*res://autoload/sfx.gd"
BloodWalls="*res://autoload/blood_walls.gd"
FX="*res://autoload/fx.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[layer_names]

3d_render/layer_1="world"
3d_render/layer_2="characters"
3d_render/layer_3="viewmodel"
3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="bot"
3d_physics/layer_4="props"
3d_physics/layer_5="ragdoll"
3d_physics/layer_6="shells"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=12

[rendering]

anti_aliasing/quality/msaa_3d=2

[shader_globals]

blood_splats={
"type": "sampler2D",
"value": ""
}
blood_count={
"type": "int",
"value": 0
}
blood_time={
"type": "float",
"value": 0.0
}
