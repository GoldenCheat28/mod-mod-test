; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Blood"
config/description="Semi-realistic ragdoll sandbox."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Game="*res://scripts/core/game.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="props"
3d_physics/layer_3="bots"
3d_physics/layer_4="player"
3d_physics/layer_5="debris"

[navigation]

3d/default_cell_size=0.2
3d/default_cell_height=0.1

[physics]

common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=6
3d/physics_engine="Jolt Physics"
jolt_physics_3d/simulation/velocity_steps=12
jolt_physics_3d/simulation/position_steps=4
common/physics_interpolation=true

[rendering]

textures/default_filters/anisotropic_filtering_level=3
environment/ssao/quality=1
limits/cluster_builder/max_clustered_elements=2048
anti_aliasing/quality/screen_space_aa=1

[shader_globals]

blood_floor={
"type": "sampler2D",
"value": ""
}
blood_wall_x={
"type": "sampler2D",
"value": ""
}
blood_wall_z={
"type": "sampler2D",
"value": ""
}
blood_area={
"type": "vec4",
"value": Vector4(-36, 72, -0.5, 11.25)
}
blood_time={
"type": "float",
"value": 0.0
}
